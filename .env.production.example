# ==============================================================================
# PAYSLIP PRO - FRONTEND PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# In production on Hostinger VPS, Nginx reverse-proxies /api to Gunicorn,
# so the API URL can simply point to the full HTTPS domain (e.g., https://yourdomain.com)
# or be left empty if frontend and backend are served from the same domain.
# ==============================================================================

VITE_API_URL=https://yourdomain.com
